<!doctype html>
<html lang="pt-br">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<title>Bater Ponto</title>
<link rel="stylesheet" href="/public/css/app.css">
<link rel="manifest" href="/manifest-kiosk.webmanifest">
<meta name="theme-color" content="#0f172a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Bater Ponto">
<link rel="apple-touch-icon" href="/public/icons/apple-touch-icon.png">
<link rel="icon" href="/public/icons/icon-192.png">
<script src="/public/js/pwa.js" defer></script>
</head>
<body>
<div class="kiosk">
  <div id="setup" class="setup" hidden>
    <h2 style="margin-top:0">Autorizar dispositivo</h2>
    <p class="muted">Cole o token gerado em <b>Dispositivos</b> no painel administrativo.</p>
    <input id="tokenInput" placeholder="token do dispositivo">
    <button id="tokenSave" class="btn" style="width:100%;margin-top:12px">Salvar</button>
    <p id="setupMsg" class="muted"></p>
  </div>

  <div id="main" hidden>
    <div class="clock" id="clock">--:--</div>
    <h1 style="margin:.2em 0">Bater ponto</h1>
    <div class="videobox">
      <video id="video" playsinline muted></video>
      <canvas id="overlay" class="overlay"></canvas>
    </div>
    <div id="status" class="status">Carregando…</div>
  </div>
  <button id="pwa-install" class="btn sec" style="margin-top:18px" hidden>📲 Instalar app</button>
</div>
<a href="/login" class="kiosk-link">painel</a>

<!-- Janela de confirmação -->
<div id="modal" class="modal" hidden>
  <div class="modal-card">
    <img id="m-photo" class="modal-photo" alt="" hidden>
    <div id="m-icon" class="modal-icon" hidden></div>
    <div id="m-name" class="modal-name"></div>
    <div id="m-sub" class="modal-sub"></div>
    <div class="modal-actions">
      <button id="m-ok" class="btn">Confirmar</button>
      <button id="m-cancel" class="btn sec">Não sou eu</button>
    </div>
    <div id="m-count" class="modal-count"></div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/dist/face-api.js"></script>
<script src="/public/js/face-common.js"></script>
<script>
const MODEL_URL = <%- JSON.stringify(faceModelUrl) %>;
const LS_KEY = 'ponto_device_token';
const video = document.getElementById('video');
const statusEl = document.getElementById('status');
const setupEl = document.getElementById('setup');
const mainEl = document.getElementById('main');

const modal = document.getElementById('modal');
const mPhoto = document.getElementById('m-photo');
const mIcon = document.getElementById('m-icon');
const mName = document.getElementById('m-name');
const mSub = document.getElementById('m-sub');
const mOk = document.getElementById('m-ok');
const mCancel = document.getElementById('m-cancel');
const mCount = document.getElementById('m-count');

let token = localStorage.getItem(LS_KEY) || '';
let coords = null;
let state = 'idle';         // idle | scanning | confirming | submitting | result
let pending = null;         // { employee, directionLabel } aguardando confirmação
let countTimer = null;

function setStatus(html, cls) { statusEl.innerHTML = html; statusEl.className = 'status ' + (cls || ''); }

function tick() {
  const d = new Date();
  document.getElementById('clock').textContent =
    String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0');
}
setInterval(tick, 1000); tick();

if (navigator.geolocation) {
  navigator.geolocation.watchPosition(
    p => { coords = { latitude: p.coords.latitude, longitude: p.coords.longitude }; },
    () => {}, { enableHighAccuracy: true, maximumAge: 30000 },
  );
}

document.getElementById('tokenSave').addEventListener('click', () => {
  const v = document.getElementById('tokenInput').value.trim();
  if (!v) return;
  localStorage.setItem(LS_KEY, v); token = v;
  location.reload();
});

// ---------- modal ----------
function clearCount() { if (countTimer) { clearInterval(countTimer); countTimer = null; } mCount.textContent = ''; }

function closeModal() {
  clearCount();
  modal.hidden = true;
  pending = null;
  state = 'scanning';
  setStatus('Aproxime o rosto para registrar o ponto');
}

function showConfirm(data) {
  state = 'confirming';
  pending = data;
  mIcon.hidden = true;
  if (data.employee.photo) { mPhoto.src = data.employee.photo; mPhoto.hidden = false; } else { mPhoto.hidden = true; }
  mName.textContent = data.employee.name;
  mName.className = 'modal-name';
  mSub.innerHTML = 'Registrar <b>' + data.directionLabel + '</b>?';
  mOk.textContent = 'Confirmar';
  mOk.hidden = false;
  mCancel.hidden = false;
  modal.hidden = false;

  let left = 20;
  clearCount();
  mCount.textContent = 'confirme em ' + left + 's';
  countTimer = setInterval(() => {
    left -= 1;
    mCount.textContent = 'confirme em ' + left + 's';
    if (left <= 0) closeModal();
  }, 1000);
}

function showResult(ok, title, sub) {
  state = 'result';
  clearCount();
  mPhoto.hidden = true;
  mIcon.hidden = false;
  mIcon.textContent = ok ? '✓' : '!';
  mIcon.className = 'modal-icon ' + (ok ? 'ok' : 'err');
  mName.textContent = title;
  mName.className = 'modal-name ' + (ok ? 'ok' : 'err');
  mSub.innerHTML = sub || '';
  mOk.textContent = 'OK';
  mOk.hidden = false;
  mCancel.hidden = true;
  modal.hidden = false;

  let left = 8;
  clearCount();
  countTimer = setInterval(() => { left -= 1; if (left <= 0) closeModal(); }, 1000);
}

mCancel.addEventListener('click', closeModal);
mOk.addEventListener('click', () => {
  if (state === 'confirming') confirmPunch();
  else closeModal();
});

// ---------- fluxo ----------
async function boot() {
  if (!token) { setupEl.hidden = false; return; }
  mainEl.hidden = false;
  try {
    setStatus('Carregando modelos…');
    await FaceKit.loadModels(MODEL_URL);
    await FaceKit.startCamera(video);
    state = 'scanning';
    setStatus('Aproxime o rosto para registrar o ponto');
    loop();
  } catch (e) {
    setStatus('Erro de câmera/modelo: ' + e.message + '<br><small>É necessário HTTPS e permitir a câmera.</small>', 'err');
  }
}

async function loop() {
  if (state === 'scanning') {
    try {
      const r = await FaceKit.detectOnce(video);
      if (r && state === 'scanning') await identify(r.descriptor);
    } catch (e) { /* ignora frame */ }
  }
  requestAnimationFrame(() => setTimeout(loop, 400));
}

async function identify(descriptor) {
  state = 'confirming'; // trava o loop enquanto consulta
  setStatus('Identificando…');
  let res, data;
  try {
    res = await fetch('/api/identify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-device-token': token },
      body: JSON.stringify({ descriptor }),
    });
    data = await res.json();
  } catch (e) {
    state = 'scanning'; setStatus('Aproxime o rosto para registrar o ponto'); return;
  }

  if (res.status === 403) {
    localStorage.removeItem(LS_KEY);
    setStatus('Dispositivo não autorizado. Recarregue para reconfigurar.', 'err');
    state = 'idle';
    return;
  }
  if (res.status === 404) {
    state = 'scanning';
    setStatus('Rosto não reconhecido. Tente novamente.', 'err');
    setTimeout(() => { if (state === 'scanning') setStatus('Aproxime o rosto para registrar o ponto'); }, 1500);
    return;
  }
  if (!res.ok) { state = 'scanning'; setStatus('Aproxime o rosto para registrar o ponto'); return; }

  if (data.cooldown > 0) {
    showResult(false, data.employee.name, 'Batida registrada há pouco. Aguarde ' + data.cooldown + 's.');
    return;
  }
  showConfirm(data);
}

async function confirmPunch() {
  if (!pending) return;
  const emp = pending.employee;
  state = 'submitting';
  clearCount();
  mOk.hidden = true; mCancel.hidden = true;
  mSub.textContent = 'Registrando…';

  let res, data;
  try {
    let shot = await FaceKit.detectOnce(video);            // valida que ainda há um rosto
    if (!shot) { await new Promise(r => setTimeout(r, 250)); shot = await FaceKit.detectOnce(video); }
    if (!shot) {
      showResult(false, 'Rosto não detectado', 'Olhe para a câmera e tente de novo.');
      return;
    }
    const photo = FaceKit.snapshot(video, 480);
    res = await fetch('/api/punch', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-device-token': token },
      body: JSON.stringify({
        descriptor: shot.descriptor,
        photo,
        expectedEmployeeId: emp.id,
        ...(coords || {}),
      }),
    });
    data = await res.json();
  } catch (e) {
    showResult(false, 'Falha de conexão', 'Tente novamente.');
    return;
  }

  if (data && data.ok) {
    showResult(true, data.employee.name, data.directionLabel + ' registrada às ' + data.punchedAt.slice(11,16) + ' · NSR ' + data.nsr);
  } else if (res.status === 429) {
    showResult(false, (data.employee || emp.name), 'Batida registrada há pouco. Aguarde ' + (data.wait || '') + 's.');
  } else if (res.status === 409) {
    showResult(false, 'Rosto mudou', 'Posicione-se de novo e confirme.');
  } else if (res.status === 404) {
    showResult(false, 'Rosto não reconhecido', 'Tente novamente.');
  } else {
    showResult(false, 'Não registrado', (data && data.error) || 'Tente novamente.');
  }
}

boot();
</script>
</body>
</html>
