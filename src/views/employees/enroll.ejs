<%- include('../partials/header', { title: 'Cadastrar rosto' }) %>
<h1>Cadastrar rosto — <%= emp.name %></h1>
<p class="sub">Matrícula <%= emp.registration %>. Capture de 3 a 5 amostras com boa iluminação, rosto próximo e olhando para a câmera.</p>

<div class="card">
  <div class="videobox">
    <video id="video" playsinline muted></video>
    <canvas id="overlay" class="overlay"></canvas>
  </div>

  <div id="msg" class="alert info" style="margin-top:14px">Carregando modelos…</div>

  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
    <button id="capture" class="btn" disabled>Capturar amostra</button>
    <button id="save" class="btn" disabled>Salvar (<span id="count">0</span>)</button>
    <a class="btn sec" href="/employees">Voltar</a>
  </div>
  <div id="thumbs" style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/dist/face-api.js"></script>
<script src="/public/js/face-common.js"></script>
<script>
const MODEL_URL = <%- JSON.stringify(faceModelUrl) %>;
const EMP_ID = <%= emp.id %>;
const video = document.getElementById('video');
const msg = document.getElementById('msg');
const samples = [];
const MIN_SAMPLES = 3;
let facePhoto = null; // recorte do rosto da 1a amostra (é a foto mostrada no kiosk)

function setMsg(t, cls) { msg.textContent = t; msg.className = 'alert ' + (cls || 'info'); }

(async () => {
  try {
    await FaceKit.loadModels(MODEL_URL);
    await FaceKit.startCamera(video);
    setMsg('Pronto. Posicione o rosto e clique em "Capturar amostra".', 'ok');
    document.getElementById('capture').disabled = false;
  } catch (e) {
    setMsg('Erro: ' + e.message + '. Verifique a permissão da câmera (exige HTTPS).', 'err');
  }
})();

document.getElementById('capture').addEventListener('click', async () => {
  setMsg('Detectando…');
  const r = await FaceKit.detectOnce(video);
  if (!r) { setMsg('Nenhum rosto detectado. Tente novamente.', 'err'); return; }
  // amostra ruim estraga o cadastro: exige rosto nítido, próximo e coerente com as anteriores
  if (r.score < 0.7) { setMsg('Rosto pouco nítido. Melhore a iluminação e olhe para a câmera.', 'err'); return; }
  if (r.faceRatio < 0.25) { setMsg('Rosto muito longe. Aproxime-se da câmera.', 'err'); return; }
  if (samples.length && FaceKit.distance(r.descriptor, samples[0]) > 0.45) {
    setMsg('Amostra muito diferente das anteriores (outra pessoa ou imagem ruim). Tente novamente.', 'err');
    return;
  }
  samples.push(r.descriptor);
  const shot = FaceKit.snapshotFace(video, r.box, 320);
  if (!facePhoto) facePhoto = shot;
  const img = document.createElement('img');
  img.src = shot;
  img.width = 90; img.style.borderRadius = '8px';
  document.getElementById('thumbs').appendChild(img);
  document.getElementById('count').textContent = samples.length;
  document.getElementById('save').disabled = samples.length < MIN_SAMPLES;
  setMsg(samples.length < MIN_SAMPLES
    ? samples.length + ' amostra(s). Capture pelo menos ' + MIN_SAMPLES + ', variando levemente a posição do rosto.'
    : samples.length + ' amostra(s) capturada(s). Pode salvar.', 'ok');
});

document.getElementById('save').addEventListener('click', async () => {
  setMsg('Salvando…');
  const photo = facePhoto; // foto da própria amostra, não de quem estiver na câmera ao salvar
  const res = await fetch('/employees/' + EMP_ID + '/face', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ descriptors: samples, photo }),
  });
  const data = await res.json();
  if (data.ok) { setMsg('Rosto salvo com ' + data.samples + ' amostras. Redirecionando…', 'ok');
    setTimeout(() => location.href = '/employees', 900);
  } else { setMsg('Erro: ' + (data.error || 'falha ao salvar'), 'err'); }
});
</script>
<%- include('../partials/footer') %>
