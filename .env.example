# Copie para .env e ajuste

# Porta HTTP (a Hostinger define automaticamente via variavel PORT)
PORT=3000
# Host de bind
HOST=0.0.0.0

# Segredo da sessao (troque por um valor aleatorio longo)
SESSION_SECRET=troque-este-valor-por-uma-string-aleatoria-bem-longa

# true quando estiver atras de HTTPS/reverse proxy (producao / Hostinger)
SECURE_COOKIES=false
TRUST_PROXY=false

# Pastas de dados persistentes (use caminhos absolutos em producao)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Reconhecimento facial
# Distancia euclidiana maxima para considerar "mesma pessoa" (0.45 a 0.6)
FACE_MATCH_THRESHOLD=0.52
# URL dos modelos do face-api.js (CDN por padrao; baixe para /public/models em producao)
FACE_MODEL_URL=https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/model/

# Regras de ponto
# Intervalo minimo entre duas batidas do mesmo funcionario (segundos) - anti duplicidade
PUNCH_MIN_INTERVAL_SECONDS=60

# Admin inicial criado pelo seed
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=admin123
